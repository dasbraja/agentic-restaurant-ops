# Gemini API key — get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ADK model
ADK_MODEL=gemini-2.5-flash

# App settings
APP_NAME=restaurant_agent
PORT=8000

# Google Cloud — for Firestore
GCP_PROJECT_ID=your_gcp_project_id_here

# Path to service account JSON (local dev only)
# On Cloud Run / GKE use Workload Identity instead
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Session storage — SQLite by default, swap for Postgres in production
# SESSION_DB_URL=postgresql+psycopg2://user:pass@host/dbname
SESSION_DB_URL=sqlite:///./restaurant_sessions.db
